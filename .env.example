# ==============================================================================
# NexusAI Environment Configuration
# ==============================================================================

# 1. NVIDIA NIM (Recommended / Default)
# Get a free key with 1000 credits at https://build.nvidia.com/
API_KEY=your_nvidia_api_key_here
MODEL_NAME=meta/llama-3.2-11b-vision-instruct
BASE_URL=https://integrate.api.nvidia.com/v1

# 2. Alternatively: OpenAI (Compatible with any standard OpenAI endpoint)
# API_KEY=sk-proj-...
# MODEL_NAME=gpt-4o-mini
# BASE_URL=https://api.openai.com/v1

# 3. Alternatively: Ollama / Local LLM
# API_KEY=ollama
# MODEL_NAME=llama3.1
# BASE_URL=http://localhost:11434/v1
